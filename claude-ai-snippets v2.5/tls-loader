<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Total Loss Studio — Processing</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:wght@300;400;500&family=Barlow:wght@300;400&display=swap" rel="stylesheet">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --black: #08080a;
  --amber: #e8952a;
  --amber-dim: rgba(232,149,42,0.15);
  --white: #f2ede6;
  --muted: #3a3840;
  --muted2: #6a6775;
  --text: #a8a5b0;
}

body {
  background: var(--black);
  color: var(--white);
  font-family: 'Barlow', sans-serif;
  min-height: 100vh;
  display: grid;
  place-items: center;
  overflow: hidden;
  position: relative;
}

/* Grid texture */
body::before {
  content: '';
  position: fixed; inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
  background-size: 80px 80px;
  pointer-events: none;
}

/* Ambient glow */
.glow {
  position: fixed;
  width: 600px; height: 600px;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(232,149,42,0.07) 0%, transparent 70%);
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
  animation: breathe 4s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
  50%       { opacity: 1;   transform: translate(-50%, -50%) scale(1.15); }
}

/* Corner marks */
.corner {
  position: fixed;
  width: 18px; height: 18px;
  border-color: rgba(232,149,42,0.25);
  border-style: solid;
}
.corner.tl { top: 24px; left: 24px; border-width: 1px 0 0 1px; }
.corner.tr { top: 24px; right: 24px; border-width: 1px 1px 0 0; }
.corner.bl { bottom: 24px; left: 24px; border-width: 0 0 1px 1px; }
.corner.br { bottom: 24px; right: 24px; border-width: 0 1px 1px 0; }

/* Top label */
.top-label {
  position: fixed;
  top: 28px; left: 50%; transform: translateX(-50%);
  font-family: 'DM Mono', monospace;
  font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase;
  color: var(--muted2);
}

/* Bottom progress bar */
.progress-track {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  height: 2px;
  background: var(--muted);
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, rgba(232,149,42,0.4), var(--amber));
  width: 0%;
  transition: width 0.15s linear;
  box-shadow: 0 0 12px rgba(232,149,42,0.6);
}

/* Main content */
.main {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  position: relative;
  z-index: 10;
  text-align: center;
}

/* Big counter */
.counter-wrap {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 4px;
}

.counter {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(120px, 22vw, 200px);
  line-height: 0.85;
  color: var(--white);
  letter-spacing: -0.02em;
  /* subtle scanline effect */
  background: linear-gradient(
    180deg,
    var(--white) 0%,
    rgba(242,237,230,0.85) 50%,
    var(--white) 100%
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  user-select: none;
}

.counter-pct {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(40px, 7vw, 64px);
  color: var(--amber);
  line-height: 1;
  margin-top: 12px;
  user-select: none;
}

/* Step label under counter */
.step-label {
  margin-top: 28px;
  font-family: 'DM Mono', monospace;
  font-size: 13px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--amber);
  min-height: 20px;
  transition: opacity 0.3s;
}

/* Divider */
.divider {
  width: 1px;
  height: 48px;
  background: linear-gradient(180deg, transparent, rgba(232,149,42,0.3), transparent);
  margin: 28px auto;
}

/* Step list — minimal, below divider */
.steps {
  display: flex;
  flex-direction: column;
  gap: 14px;
  align-items: center;
}

.step {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  transition: color 0.4s;
}

.step.active { color: var(--text); }
.step.done   { color: var(--muted2); }

.step-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  border: 1px solid var(--muted);
  flex-shrink: 0;
  transition: all 0.4s;
  position: relative;
}

.step.active .step-dot {
  background: var(--amber);
  border-color: var(--amber);
  box-shadow: 0 0 8px rgba(232,149,42,0.7);
  animation: pulse-dot 1s ease-in-out infinite;
}

.step.done .step-dot {
  background: var(--muted2);
  border-color: var(--muted2);
}

@keyframes pulse-dot {
  0%, 100% { box-shadow: 0 0 8px rgba(232,149,42,0.7); }
  50%       { box-shadow: 0 0 16px rgba(232,149,42,1); }
}

/* Complete state */
.complete-msg {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 18px;
  letter-spacing: 0.2em;
  color: var(--amber);
  margin-top: 32px;
  opacity: 0;
  transform: translateY(8px);
  transition: all 0.5s ease;
}
.complete-msg.show {
  opacity: 1;
  transform: translateY(0);
}

/* Scanline sweep animation across counter */
.counter-wrap::after {
  content: '';
  position: absolute;
  left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, rgba(232,149,42,0.4), transparent);
  top: 0;
  animation: scan 2.5s linear infinite;
  pointer-events: none;
}

@keyframes scan {
  0%   { top: 0%;   opacity: 0; }
  10%  { opacity: 1; }
  90%  { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}

/* Flicker on number change */
@keyframes flicker {
  0%   { opacity: 1; }
  20%  { opacity: 0.7; }
  40%  { opacity: 1; }
  60%  { opacity: 0.85; }
  100% { opacity: 1; }
}
.flicker { animation: flicker 0.08s linear; }
</style>
</head>
<body>

<div class="glow"></div>

<!-- Corner brackets -->
<div class="corner tl"></div>
<div class="corner tr"></div>
<div class="corner bl"></div>
<div class="corner br"></div>

<div class="top-label">Total Loss Studio — Processing Estimate</div>

<!-- Bottom progress bar -->
<div class="progress-track">
  <div class="progress-fill" id="progressFill"></div>
</div>

<!-- Main -->
<div class="main">

  <div class="counter-wrap">
    <div class="counter" id="counter">0</div>
    <div class="counter-pct">%</div>
  </div>

  <div class="step-label" id="stepLabel">Initializing...</div>

  <div class="divider"></div>

  <div class="steps" id="stepList">
    <div class="step" id="s0">
      <div class="step-dot"></div>
      <span>Building the Cipher</span>
    </div>
    <div class="step" id="s1">
      <div class="step-dot"></div>
      <span>Marking the Frame</span>
    </div>
    <div class="step" id="s2">
      <div class="step-dot"></div>
      <span>Setting the Weight</span>
    </div>
    <div class="step" id="s3">
      <div class="step-dot"></div>
      <span>Sealing the Record</span>
    </div>
    <div class="step" id="s4">
      <div class="step-dot"></div>
      <span>Cipher Complete</span>
    </div>
  </div>

  <div class="complete-msg" id="completeMsg">— Output Ready —</div>

</div>

<script>
const steps = [
  { id: 's0', label: 'Building the Cipher',  start: 0,  end: 20  },
  { id: 's1', label: 'Marking the Frame',    start: 20, end: 45  },
  { id: 's2', label: 'Setting the Weight',   start: 45, end: 70  },
  { id: 's3', label: 'Sealing the Record',   start: 70, end: 92  },
  { id: 's4', label: 'Cipher Complete',      start: 92, end: 100 },
];

const counterEl    = document.getElementById('counter');
const stepLabelEl  = document.getElementById('stepLabel');
const progressFill = document.getElementById('progressFill');
const completeMsg  = document.getElementById('completeMsg');

let current = 0;
let activeStep = -1;

// Easing — slow at start and end, fast in middle
function easeInOut(t) {
  return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
}

// Total animation duration ms
const TOTAL_DURATION = 3800;
const startTime = performance.now();

function updateStep(pct) {
  let newStep = -1;
  for (let i = steps.length - 1; i >= 0; i--) {
    if (pct >= steps[i].start) { newStep = i; break; }
  }

  if (newStep !== activeStep) {
    // Mark old as done
    if (activeStep >= 0) {
      document.getElementById(steps[activeStep].id).className = 'step done';
    }
    activeStep = newStep;
    if (activeStep >= 0) {
      document.getElementById(steps[activeStep].id).className = 'step active';
      stepLabelEl.textContent = steps[activeStep].label;
    }
  }
}

function tick(now) {
  const elapsed = now - startTime;
  const t = Math.min(elapsed / TOTAL_DURATION, 1);
  const eased = easeInOut(t);
  const pct = Math.round(eased * 100);

  // Update counter with flicker on change
  if (pct !== current) {
    current = pct;
    counterEl.textContent = String(pct).padStart(2, ' ');
    counterEl.classList.remove('flicker');
    void counterEl.offsetWidth; // reflow
    counterEl.classList.add('flicker');
  }

  // Progress bar
  progressFill.style.width = pct + '%';

  // Steps
  updateStep(pct);

  if (t < 1) {
    requestAnimationFrame(tick);
  } else {
    // Complete
    counterEl.textContent = '100';
    progressFill.style.width = '100%';
    stepLabelEl.textContent = 'Cipher Complete';
    document.getElementById('s4').className = 'step done';
    completeMsg.classList.add('show');

    // In real app — redirect or reveal output after short pause
    // setTimeout(() => { window.location.href = '/output'; }, 800);
  }
}

// Small delay before starting — feels intentional
setTimeout(() => {
  stepLabelEl.textContent = steps[0].label;
  document.getElementById('s0').className = 'step active';
  requestAnimationFrame(tick);
}, 400);
</script>

</body>
</html>