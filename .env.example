# ─────────────────────────────────────────────
# CLAIM CIPHER — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Google Maps ─────────────────────────────────────────────────────────────
# Found in: Google Cloud Console → APIs & Services → Credentials
# Required APIs: Maps JavaScript API, Directions API, Geocoding API, Places API
# Restrict the key to your production domain in the Cloud Console.

GOOGLE_MAPS_API_KEY=your-maps-key-here

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Found in: Stripe Dashboard → Developers → API Keys

STRIPE_SECRET_KEY=sk_live_your-key-here
STRIPE_PRICE_BASIC=price_your-id-here
STRIPE_PRICE_PRO=price_your-id-here
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here

# Pro plan setup fee price ID (if applicable)
STRIPE_PRICE_PRO_SETUP=price_XXXXXXXXXXXXXXXXXXXXXXXX

# ─── App ─────────────────────────────────────────────────────────────────────
# The canonical public URL for this deployment.

# Production domain — used for Stripe redirects
APP_URL=https://claimcipherhq.com
