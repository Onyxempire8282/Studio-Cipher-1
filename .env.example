# Claim Cipher — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your project's REST endpoint
SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key — safe to expose in client-side JS
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose in client-side code (server/edge functions only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Google Maps ─────────────────────────────────────────────────────────────
# Found in: Google Cloud Console → APIs & Services → Credentials
# Required APIs: Maps JavaScript API, Directions API, Geocoding API
# Restrict the key to your production domain in the Cloud Console.

GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Found in: Stripe Dashboard → Products → (select plan) → Price ID
# Use test-mode price IDs (price_test_...) for staging, live IDs for production.

# Basic plan price ID
STRIPE_PRICE_BASIC=price_your_basic_plan_id

# Pro plan price ID
STRIPE_PRICE_PRO=price_your_pro_plan_id

# ─── App ─────────────────────────────────────────────────────────────────────
# The canonical public URL for this deployment.
# GitHub Pages example: https://yourusername.github.io/studio_cipher-1

APP_URL=https://your-github-pages-url-here
