    <div>
      <strong>Professional User</strong>
      Claims Specialist
    </div>
    <button class="nav-logout">Logout</button>
  </div>
</nav>

<!-- PAGE HEADER -->
<div class="page-header">
  <div class="page-header-inner">
    <div class="page-title-block">
      <div class="page-label">Total Loss Studio</div>
      <div class="page-title">Summary Verification</div>
      <div class="page-sub">Review all extracted data before generating the BCIF form</div>
    </div>
    <div class="claim-badge">
      <div class="claim-badge-num">L005028073</div>
      <div class="claim-badge-vehicle">2025 Ford Police · 1FM5K8AC2SGA31859</div>
    </div>
  </div>
</div>

<!-- VERIFY BANNER -->
<div class="verify-banner">
  <div class="verify-banner-inner">
    <div class="verify-dot"></div>
    <div class="verify-text">Verify Before Committing</div>
    <div class="verify-sub">— Correct any errors below. Downloads are final.</div>
  </div>
</div>

<!-- MAIN -->
<div class="main">

  <!-- CLAIM + VEHICLE INFO -->
  <div class="card accent">
    <div class="card-header">
      <div class="card-header-title">Claim & Vehicle Information</div>
      <div class="card-header-line"></div>
    </div>
    <div class="card-body" style="padding:3px">
