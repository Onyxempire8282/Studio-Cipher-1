          </div>
          <div class="field">
            <div class="field-label">Adjuster</div>
            <input class="field-value" type="text" placeholder="Enter adjuster name">
          </div>
        </div>
        <div class="info-col">
          <div class="info-col-label">Vehicle</div>
          <div class="field">
            <div class="field-label">Year</div>
            <input class="field-value" type="text" value="2025">
          </div>
          <div class="field">
            <div class="field-label">Make</div>
            <input class="field-value" type="text" value="FORD">
          </div>
          <div class="field">
            <div class="field-label">Model</div>
            <input class="field-value" type="text" value="Police">
          </div>
          <div class="field">
            <div class="field-label">VIN</div>
