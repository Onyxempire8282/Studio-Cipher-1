<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Total Loss Studio — Upload Estimate</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:wght@300;400;500&family=Barlow:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --plate:      #0e0f11;
  --steel:      #161a1d;
  --steel-mid:  #1e2328;
  --steel-lift: #252b31;
  --input-bg:   #0a0c0e;
  --rivet:      #2e353d;
  --rivet-hi:   #3d464f;
  --amber:      #e8952a;
  --amber-dim:  rgba(232,149,42,0.12);
  --amber-line: rgba(232,149,42,0.35);
  --amber-glow: rgba(232,149,42,0.06);
  --white:      #edeae4;
  --text:       #8f9399;
  --text-hi:    #b8bdc2;
  --muted:      #4a5058;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }

body {
  background: var(--plate);
  color: var(--text-hi);
  font-family: 'Barlow', sans-serif;
  font-weight: 300;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Grid texture */
body::before {
  content: '';
  position: fixed; inset: 0; z-index: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.013) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.013) 1px, transparent 1px);
  background-size: 48px 48px;
  pointer-events: none;
}

/* ── NAV ── */
.nav {
  position: relative; z-index: 10;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 32px; height: 56px;
  background: rgba(14,15,17,0.98);
  border-bottom: 1px solid var(--rivet);
  box-shadow: 0 1px 0 rgba(232,149,42,0.07);
  flex-shrink: 0;
}

.nav-tabs { display: flex; gap: 0; height: 100%; }
.nav-tab {
  display: flex; align-items: center; padding: 0 20px;
  font-family: 'DM Mono', monospace;
  font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--muted); cursor: pointer;
  border-right: 1px solid var(--rivet);
  border-left: 1px solid transparent;
  transition: all 0.2s; text-decoration: none;
}
.nav-tab:first-child { border-left: 1px solid var(--rivet); }
.nav-tab:hover { color: var(--text-hi); background: rgba(255,255,255,0.02); }
.nav-tab.active {
  color: var(--amber); background: var(--amber-dim);
  border-bottom: 2px solid var(--amber);
}

.nav-user {
  display: flex; align-items: center; gap: 16px;
  font-family: 'DM Mono', monospace; font-size: 10px;
  letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);
}
.nav-user strong { color: var(--text-hi); display: block; font-size: 11px; }
.nav-logout {
  padding: 7px 16px; border: 1px solid var(--rivet);
  color: var(--muted); font-family: 'DM Mono', monospace;
  font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
  cursor: pointer; transition: all 0.2s; background: transparent;
}
.nav-logout:hover { border-color: var(--rivet-hi); color: var(--text-hi); }

/* ── PAGE HEADER ── */
.page-header {
  background: var(--steel);
  border-bottom: 1px solid var(--rivet);
  padding: 20px 40px;
  position: relative; z-index: 1; flex-shrink: 0;
}
.page-header-inner {
  max-width: 1100px; margin: 0 auto;
  display: flex; align-items: center; justify-content: space-between;
}
.page-label {
  font-family: 'DM Mono', monospace;
  font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--amber);
  margin-bottom: 4px;
}
.page-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 28px; letter-spacing: 0.06em; color: var(--white);
}
.page-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }

.header-meta {
  font-family: 'DM Mono', monospace;
  font-size: 10px; color: var(--muted); letter-spacing: 0.1em; text-align: right;
  line-height: 1.8;
}
.header-meta span { color: var(--text); }

/* ── MAIN STAGE ── */
.stage {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
  position: relative; z-index: 1;
}

/* Ambient glow behind drop zone */
.stage-glow {
  position: absolute;
  width: 500px; height: 500px;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(232,149,42,0.06) 0%, transparent 70%);
  pointer-events: none;
  animation: breathe 5s ease-in-out infinite;
}
@keyframes breathe {
  0%,100% { transform: scale(1); opacity: 0.7; }
  50%      { transform: scale(1.12); opacity: 1; }
}

/* ── UPLOAD PANEL ── */
.upload-panel {
  width: 100%; max-width: 680px;
  position: relative; z-index: 2;
}

/* Panel chrome */
.panel-chrome {
  background: var(--steel);
  border: 1px solid var(--rivet);
  border-left: 3px solid var(--amber);
  position: relative;
}

/* Corner rivets */
.panel-chrome::before,
.panel-chrome::after {
  content: '';
  position: absolute;
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--rivet-hi);
  border: 1px solid var(--muted);
}
.panel-chrome::before { top: 10px; right: 12px; }
.panel-chrome::after  { bottom: 10px; right: 12px; }

.panel-header {
  padding: 14px 24px;
  border-bottom: 1px solid var(--rivet);
  background: var(--steel-mid);
  display: flex; align-items: center; gap: 12px;
}
.panel-title {
  font-family: 'DM Mono', monospace;
  font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--amber);
}
.panel-line {
  flex: 1; height: 1px;
  background: linear-gradient(90deg, var(--amber-line), transparent);
}
.panel-status {
  font-family: 'DM Mono', monospace;
  font-size: 10px; color: var(--muted); letter-spacing: 0.1em;
  display: flex; align-items: center; gap: 6px;
}
.status-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--muted); border: 1px solid var(--rivet-hi);
}
.status-dot.ready {
  background: var(--amber);
  box-shadow: 0 0 6px rgba(232,149,42,0.6);
  animation: pulse-s 2s ease-in-out infinite;
}
@keyframes pulse-s {
  0%,100% { box-shadow: 0 0 6px rgba(232,149,42,0.6); }
  50%      { box-shadow: 0 0 12px rgba(232,149,42,1); }
}

.panel-body { padding: 28px; }

/* ── DROP ZONE ── */
.dropzone {
  background: var(--input-bg);
  border: 1px dashed rgba(232,149,42,0.3);
  position: relative;
  padding: 56px 40px;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 16px; text-align: center;
  cursor: pointer;
  transition: all 0.25s;
  overflow: hidden;
}

/* Corner brackets on drop zone */
.dropzone::before {
  content: '';
  position: absolute;
  inset: 6px;
  border: 1px solid rgba(232,149,42,0.08);
  pointer-events: none;
  transition: border-color 0.25s;
}

.dropzone:hover,
.dropzone.drag-over {
  border-color: var(--amber);
  background: rgba(10,12,14,0.95);
  box-shadow: inset 0 0 40px rgba(232,149,42,0.05), 0 0 0 1px rgba(232,149,42,0.1);
}
.dropzone:hover::before,
.dropzone.drag-over::before {
  border-color: rgba(232,149,42,0.2);
}

/* Scan line sweep on hover */
.dropzone::after {
  content: '';
  position: absolute;
  left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(232,149,42,0.3), transparent);
  top: -100%;
  opacity: 0;
  transition: opacity 0.2s;
}
.dropzone:hover::after {
  opacity: 1;
  animation: sweep 2s linear infinite;
}
@keyframes sweep {
  0%   { top: 0%; }
  100% { top: 100%; }
}

/* Upload icon */
.upload-icon-wrap {
  width: 64px; height: 64px;
  border: 1px solid var(--rivet);
  background: var(--steel-mid);
  display: grid; place-items: center;
  position: relative;
  transition: all 0.25s;
}
.dropzone:hover .upload-icon-wrap {
  border-color: var(--amber-line);
  background: var(--amber-dim);
}
.upload-icon {
  width: 24px; height: 24px;
  position: relative;
}
/* Arrow up icon drawn in CSS */
.upload-icon::before {
  content: '';
  position: absolute;
  left: 50%; top: 2px;
  transform: translateX(-50%);
  width: 0; height: 0;
  border-left: 8px solid transparent;
  border-right: 8px solid transparent;
  border-bottom: 10px solid var(--muted);
  transition: border-bottom-color 0.25s;
}
.upload-icon::after {
  content: '';
  position: absolute;
  left: 50%; top: 10px;
  transform: translateX(-50%);
  width: 4px; height: 12px;
  background: var(--muted);
  transition: background 0.25s;
}
.dropzone:hover .upload-icon::before { border-bottom-color: var(--amber); }
.dropzone:hover .upload-icon::after  { background: var(--amber); }

/* Tray line at bottom of icon */
.upload-tray {
  width: 24px; height: 2px;
  background: var(--rivet-hi);
  margin-top: -2px;
  transition: background 0.25s;
}
.dropzone:hover .upload-tray { background: var(--amber); }

.drop-headline {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 26px; letter-spacing: 0.06em; color: var(--white);
}
.drop-sub {
  font-family: 'DM Mono', monospace;
  font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
}

/* Divider or */
.drop-or {
  display: flex; align-items: center; gap: 14px; width: 100%; max-width: 240px;
}
.drop-or-line { flex: 1; height: 1px; background: var(--rivet); }
.drop-or-text {
  font-family: 'DM Mono', monospace;
  font-size: 10px; color: var(--muted); letter-spacing: 0.15em;
}

/* Browse button */
.browse-btn {
  background: var(--amber);
  color: #000;
  font-family: 'DM Mono', monospace;
  font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase;
  padding: 12px 36px; border: none; cursor: pointer;
  transition: all 0.2s; position: relative; z-index: 1;
  box-shadow: 0 0 20px rgba(232,149,42,0.2);
}
.browse-btn:hover {
  background: #f0a030;
  box-shadow: 0 0 32px rgba(232,149,42,0.4);
  transform: translateY(-1px);
}

/* Hidden file input */
#fileInput { display: none; }

/* ── SPECS ROW ── */
.specs-row {
  display: grid; grid-template-columns: repeat(3,1fr);
  border-top: 1px solid var(--rivet);
}
.spec {
  padding: 14px 20px;
  border-right: 1px solid var(--rivet);
  display: flex; flex-direction: column; gap: 4px;
}
.spec:last-child { border-right: none; }
.spec-label {
  font-family: 'DM Mono', monospace;
  font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
}
.spec-value {
  font-size: 12px; color: var(--text-hi);
}

/* ── HISTORY STRIP ── */
.history-strip {
  margin-top: 3px;
  background: var(--steel-mid);
  border: 1px solid var(--rivet);
  border-left: 3px solid var(--rivet-hi);
}
.history-header {
  padding: 10px 20px;
  border-bottom: 1px solid var(--rivet);
  display: flex; align-items: center; gap: 10px;
}
.history-title {
  font-family: 'DM Mono', monospace;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
}
.history-line { flex: 1; height: 1px; background: var(--rivet); }

.history-items { display: flex; flex-direction: column; }
.history-item {
  display: flex; align-items: center; gap: 16px;
  padding: 11px 20px;
  border-bottom: 1px solid rgba(255,255,255,0.03);
  transition: background 0.15s; cursor: pointer;
}
.history-item:last-child { border-bottom: none; }
.history-item:hover { background: rgba(255,255,255,0.02); }
.history-icon {
  width: 28px; height: 28px;
  background: var(--steel-lift); border: 1px solid var(--rivet);
  display: grid; place-items: center; flex-shrink: 0;
  font-size: 10px; color: var(--muted);
}
.history-info { flex: 1; display: flex; flex-direction: column; gap: 2px; }
.history-name {
  font-size: 12px; color: var(--text-hi); font-weight: 400;
}
.history-meta {
  font-family: 'DM Mono', monospace;
  font-size: 10px; color: var(--muted); letter-spacing: 0.06em;
}
.history-action {
  font-family: 'DM Mono', monospace;
  font-size: 10px; color: var(--muted); letter-spacing: 0.1em;
  text-transform: uppercase; padding: 5px 12px;
  border: 1px solid var(--rivet);
  transition: all 0.2s;
}
.history-action:hover { border-color: var(--amber-line); color: var(--amber); }

/* ── DRAG OVER STATE ── */
.dropzone.drag-over .drop-headline { color: var(--amber); }

/* ── FILE SELECTED STATE ── */
.file-selected-state {
  display: none;
  flex-direction: column; align-items: center; gap: 14px; text-align: center;
}
.file-icon-wrap {
  width: 64px; height: 64px;
  background: var(--amber-dim); border: 1px solid var(--amber-line);
  display: grid; place-items: center;
  font-size: 22px;
}
.file-name {
  font-family: 'DM Mono', monospace;
  font-size: 12px; color: var(--amber); letter-spacing: 0.08em;
}
.file-size { font-size: 11px; color: var(--muted); }
.file-proceed {
  background: var(--amber); color: #000;
  font-family: 'DM Mono', monospace;
  font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase;
  padding: 12px 40px; border: none; cursor: pointer;
  transition: all 0.2s;
  box-shadow: 0 0 20px rgba(232,149,42,0.25);
}
.file-proceed:hover {
  background: #f0a030;
  box-shadow: 0 0 32px rgba(232,149,42,0.4);
}
.file-cancel {
  font-family: 'DM Mono', monospace; font-size: 10px;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--muted); background: none; border: none;
  cursor: pointer; transition: color 0.2s;
}
.file-cancel:hover { color: var(--text-hi); }

</style>
</head>
<body>

<!-- NAV -->
<nav class="nav">
  <div class="nav-tabs">
    <a class="nav-tab" href="#">Dashboard</a>
    <a class="nav-tab" href="#">Routes</a>
    <a class="nav-tab" href="#">Mileage</a>
    <a class="nav-tab" href="#">My Routes</a>
    <a class="nav-tab active" href="#">Total Loss</a>
  </div>
  <div class="nav-user">
    <div>
      <strong>Professional User</strong>
      Claims Specialist
    </div>
    <button class="nav-logout">Logout</button>
  </div>
</nav>

<!-- PAGE HEADER -->
<div class="page-header">
  <div class="page-header-inner">
    <div>
      <div class="page-label">Total Loss Studio</div>
      <div class="page-title">Upload Estimate</div>
      <div class="page-sub">CCC estimate processing and BCIF form generation</div>
    </div>
    <div class="header-meta">
      Accepted Format <span>PDF</span><br>
      Max Size <span>25 MB</span><br>
      Source <span>CCC ONE</span>
    </div>
  </div>
</div>

<!-- STAGE -->
<div class="stage">
  <div class="stage-glow"></div>

  <div class="upload-panel">

    <!-- MAIN UPLOAD PANEL -->
    <div class="panel-chrome">
      <div class="panel-header">
        <div class="panel-title">Load Estimate</div>
        <div class="panel-line"></div>
        <div class="panel-status">
          <div class="status-dot ready"></div>
          Ready
        </div>
      </div>

      <div class="panel-body">
        <!-- DROP ZONE -->
        <div class="dropzone" id="dropzone">

          <!-- Default state -->
          <div id="defaultState" style="display:flex;flex-direction:column;align-items:center;gap:16px">
            <div class="upload-icon-wrap">
              <div style="display:flex;flex-direction:column;align-items:center">
                <div class="upload-icon"></div>
                <div class="upload-tray"></div>
              </div>
            </div>

            <div>
              <div class="drop-headline">Drop CCC Estimate Here</div>
              <div class="drop-sub" style="margin-top:6px">PDF format · CCC ONE exports accepted</div>
            </div>

            <div class="drop-or">
              <div class="drop-or-line"></div>
              <div class="drop-or-text">or</div>
              <div class="drop-or-line"></div>
            </div>

            <button class="browse-btn" onclick="document.getElementById('fileInput').click()">
              Browse Files
            </button>
          </div>

          <!-- File selected state -->
          <div class="file-selected-state" id="selectedState">
            <div class="file-icon-wrap">PDF</div>
            <div>
              <div class="file-name" id="fileName">estimate.pdf</div>
              <div class="file-size" id="fileSize">2.4 MB</div>
            </div>
            <button class="file-proceed" onclick="alert('Processing...')">
              Process Estimate →
            </button>
            <button class="file-cancel" id="cancelBtn">✕ Remove file</button>
          </div>

          <input type="file" id="fileInput" accept=".pdf">
        </div>
      </div>

      <!-- SPECS ROW -->
      <div class="specs-row">
        <div class="spec">
          <div class="spec-label">Accepted Source</div>
          <div class="spec-value">CCC ONE</div>
        </div>
        <div class="spec">
          <div class="spec-label">Output</div>
          <div class="spec-value">BCIF + Claim Summary</div>
        </div>
        <div class="spec">
          <div class="spec-label">Processing</div>
          <div class="spec-value">~4 seconds</div>
        </div>
      </div>
    </div>

    <!-- RECENT HISTORY -->
    <div class="history-strip">
      <div class="history-header">
        <div class="history-title">Recent</div>
        <div class="history-line"></div>
      </div>
      <div class="history-items">
        <div class="history-item">
          <div class="history-icon">PDF</div>
          <div class="history-info">
            <div class="history-name">CCC_L005028073_Ford_Police.pdf</div>
            <div class="history-meta">Today · 14:02 · 2025 Ford Police · L005028073</div>
          </div>
          <div class="history-action">Reload</div>
        </div>
        <div class="history-item">
          <div class="history-icon">PDF</div>
          <div class="history-info">
            <div class="history-name">CCC_L004991201_Chevy_Tahoe.pdf</div>
            <div class="history-meta">Yesterday · 09:44 · 2023 Chevy Tahoe · L004991201</div>
          </div>
          <div class="history-action">Reload</div>
        </div>
      </div>
    </div>

  </div><!-- /upload-panel -->
</div><!-- /stage -->

<script>
const dropzone    = document.getElementById('dropzone');
const fileInput   = document.getElementById('fileInput');
const defaultState  = document.getElementById('defaultState');
const selectedState = document.getElementById('selectedState');
const fileNameEl  = document.getElementById('fileName');
const fileSizeEl  = document.getElementById('fileSize');
const cancelBtn   = document.getElementById('cancelBtn');

function showFile(file) {
  fileNameEl.textContent = file.name;
  fileSizeEl.textContent = (file.size / 1024 / 1024).toFixed(1) + ' MB';
  defaultState.style.display = 'none';
  selectedState.style.display = 'flex';
  dropzone.style.borderColor = 'var(--amber)';
  dropzone.style.borderStyle = 'solid';
}

function reset() {
  defaultState.style.display = 'flex';
  selectedState.style.display = 'none';
  dropzone.style.borderColor = '';
  dropzone.style.borderStyle = '';
  fileInput.value = '';
}

fileInput.addEventListener('change', e => {
  if (e.target.files[0]) showFile(e.target.files[0]);
});

cancelBtn.addEventListener('click', e => {
  e.stopPropagation(); reset();
});

dropzone.addEventListener('dragover', e => {
  e.preventDefault(); dropzone.classList.add('drag-over');
});
dropzone.addEventListener('dragleave', () => dropzone.classList.remove('drag-over'));
dropzone.addEventListener('drop', e => {
  e.preventDefault(); dropzone.classList.remove('drag-over');
  const file = e.dataTransfer.files[0];
  if (file) showFile(file);
});
</script>

</body>
</html>