        </div>
      </div>
    </div>
  </div>

  <!-- CONDITION -->
  <div class="card">
    <div class="card-header">
      <div class="card-header-title">Condition</div>
      <div class="card-header-line"></div>
    </div>

    <!-- EXTERIOR -->
    <div class="sub-section">
      <div class="sub-label">Exterior</div>
      <div class="condition-grid">
        <div class="condition-item">
          <div class="condition-name">Paint</div>
          <div class="rating-row">
            <div class="rating-bar"><div class="rating-fill" style="width:75%"></div></div>
            <div class="rating-value">Good</div>
          </div>
          <div class="condition-note">Normal wear for age. Minor chips or scratches. No major deterioration.</div>
        </div>
        <div class="condition-item">
          <div class="condition-name">Sheet Metal</div>
          <div class="rating-row">
            <div class="rating-bar"><div class="rating-fill" style="width:75%"></div></div>
            <div class="rating-value">Good</div>
          </div>
          <div class="condition-note">Minor dings or typical wear. Panels align properly.</div>
        </div>
        <div class="condition-item">
          <div class="condition-name">Glass</div>
          <div class="rating-row">
            <div class="rating-bar"><div class="rating-fill" style="width:75%"></div></div>
            <div class="rating-value">Good</div>
          </div>
          <div class="condition-note">Light wear or minor pitting. No structural cracks.</div>
        </div>
        <div class="condition-item">
          <div class="condition-name">Trim</div>
          <div class="rating-row">
            <div class="rating-bar"><div class="rating-fill" style="width:75%"></div></div>
            <div class="rating-value">Good</div>
          </div>
          <div class="condition-note">Normal wear. Minor blemishes only.</div>
